+    steps:
+      - uses: actions/checkout@v7.0.1
+      - name: Test shared data and analysis core
+        run: swift test --package-path ios
+      - name: Generate native project
+        run: python3 ios/generate_project.py
+      - name: Compile simulator app without signing
+        run: >-
