+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/Paulyang5049/tennis-ai-local/contracts/analysis-v2.schema.json",
+  "title": "AnalysisPackage v2 manifest",
+  "type": "object",
+  "required": ["schema_version", "media", "settings", "model_provenance", "status", "coordinate_system", "artifacts"],
+  "properties": {
+    "schema_version": {"const": 2},
+    "coordinate_system": {"const": "oriented_pixels_top_left"},
+    "status": {"enum": ["running", "paused", "cancelled", "failed", "inference_complete", "complete"]},
+    "media": {
+      "type": "object", "required": ["id", "sha256", "path", "width", "height", "duration", "origin"],
+      "properties": {
+        "id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "minLength": 1},
+        "path": {"$ref": "#/$defs/asset"},
+        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
+        "duration": {"type": "number", "exclusiveMinimum": 0}, "origin": {"type": "number"},
+        "fps": {"type": "number", "exclusiveMinimum": 0}, "has_audio": {"type": "boolean"}
+      }
+    },
+    "settings": {"type": "object", "required": ["players"], "properties": {"players": {"enum": [2, 4]}}},
+    "model_provenance": {"type": "object", "additionalProperties": {"type": "string"}},
+    "artifacts": {
+      "type": "object", "required": ["frames", "events", "corrections"],
+      "additionalProperties": {"$ref": "#/$defs/asset"}
+    }
+  },
+  "$defs": {
+    "asset": {"type": "string", "minLength": 1, "description": "Contained relative path. Runtime additionally resolves symlinks and rejects traversal."}
+  }
+}
