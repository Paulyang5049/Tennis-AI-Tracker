{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metrics": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "definition",
          "version",
          "view",
          "value",
          "numerator",
          "denominator",
          "event_ids",
          "excluded_event_ids",
          "input_digest",
          "review_policy_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "view": {
            "enum": [
              "human_verified",
              "assisted"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "numerator": {
            "type": "number",
            "minimum": 0
          },
          "denominator": {
            "type": "number",
            "minimum": 0
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "excluded_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "input_digest": {
            "type": "string",
            "minLength": 1
          },
          "review_policy_version": {
            "const": "human-reviewed-v1"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
