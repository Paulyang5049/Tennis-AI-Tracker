{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-frame capture eligibility, not recognition accuracy",
  "type": "object",
  "required": ["schema_version", "eligible_for_positions", "court_visible", "camera_moving", "scene_cut", "calibration_id", "reasons"],
  "properties": {
    "schema_version": {"const": 1},
    "eligible_for_positions": {"type": "boolean"},
    "court_visible": {"type": "boolean"},
    "camera_moving": {"type": "boolean"},
    "scene_cut": {"type": "boolean"},
    "calibration_id": {"type": ["string", "null"]},
    "calibration_age_s": {"type": ["number", "null"], "minimum": 0},
    "sharpness": {"type": ["number", "null"], "minimum": 0},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["missing_calibration", "invalid_calibration", "court_out_of_view", "camera_moving", "scene_cut", "stale_calibration", "low_sharpness"]}}
  },
  "additionalProperties": false
}
