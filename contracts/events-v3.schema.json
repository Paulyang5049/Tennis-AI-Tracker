{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "events",
    "participants",
    "assignments",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "allOf": [
          {
            "$ref": "events-v2.schema.json#/$defs/event"
          },
          {
            "type": "object",
            "properties": {
              "participant_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "contact_interval": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "contact_point_image_px": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "hitter_position_court_m": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "field_confidence": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "position_source": {
                "enum": [
                  "reviewed_bounce",
                  "legacy_v2",
                  null
                ]
              }
            }
          }
        ]
      }
    },
    "participants": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "self",
              "opponent",
              "partner",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "assignments": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scene",
          "start",
          "end",
          "track_id",
          "side",
          "participant_id",
          "reviewed",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scene": {
            "type": "integer",
            "minimum": 0
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "track_id": {
            "type": "integer"
          },
          "side": {
            "enum": [
              "near",
              "far"
            ]
          },
          "participant_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reviewed": {
            "type": "boolean"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "shot_id",
          "bounce_id",
          "reviewed",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "bounce_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed": {
            "type": "boolean"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
