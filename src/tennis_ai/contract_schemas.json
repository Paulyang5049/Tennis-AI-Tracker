{
  "analysis-v2.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Paulyang5049/tennis-ai-local/contracts/analysis-v2.schema.json",
    "title": "AnalysisPackage v2 manifest",
    "type": "object",
    "required": [
      "schema_version",
      "media",
      "settings",
      "model_provenance",
      "status",
      "coordinate_system",
      "artifacts"
    ],
    "properties": {
      "schema_version": {
        "const": 2
      },
      "coordinate_system": {
        "const": "oriented_pixels_top_left"
      },
      "status": {
        "enum": [
          "running",
          "paused",
          "cancelled",
          "failed",
          "inference_complete",
          "complete"
        ]
      },
      "media": {
        "type": "object",
        "required": [
          "id",
          "sha256",
          "path",
          "width",
          "height",
          "duration",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/asset"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "origin": {
            "type": "number"
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "has_audio": {
            "type": "boolean"
          }
        }
      },
      "settings": {
        "type": "object",
        "required": [
          "players"
        ],
        "properties": {
          "players": {
            "enum": [
              2,
              4
            ]
          }
        }
      },
      "model_provenance": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "artifacts": {
        "type": "object",
        "required": [
          "frames",
          "events",
          "corrections"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "$defs": {
      "asset": {
        "type": "string",
        "minLength": 1,
        "description": "Contained relative path. Runtime additionally resolves symlinks and rejects traversal."
      }
    }
  },
  "analysis-v3.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "media",
      "settings",
      "model_provenance",
      "status",
      "coordinate_system",
      "court_coordinate_system",
      "artifacts",
      "asset_versions",
      "review_policy_version",
      "derivation_versions",
      "storage_policy"
    ],
    "properties": {
      "court_coordinate_system": {
        "const": "far_left_x_right_y_near_m"
      },
      "schema_version": {
        "const": 3
      },
      "media": {
        "$ref": "analysis-v2.schema.json#/properties/media"
      },
      "settings": {
        "$ref": "analysis-v2.schema.json#/properties/settings"
      },
      "model_provenance": {
        "$ref": "analysis-v2.schema.json#/properties/model_provenance"
      },
      "status": {
        "$ref": "analysis-v2.schema.json#/properties/status"
      },
      "coordinate_system": {
        "const": "oriented_pixels_top_left"
      },
      "artifacts": {
        "type": "object",
        "required": [
          "frames",
          "events",
          "corrections",
          "tracks",
          "rallies",
          "metrics",
          "insights",
          "audit"
        ],
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "asset_versions": {
        "type": "object",
        "required": [
          "frames",
          "events",
          "corrections",
          "tracks",
          "rallies",
          "metrics",
          "insights",
          "audit"
        ],
        "properties": {
          "frames": {
            "const": 2
          },
          "events": {
            "const": 3
          },
          "corrections": {
            "const": 2
          },
          "tracks": {
            "const": 1
          },
          "rallies": {
            "const": 1
          },
          "metrics": {
            "const": 1
          },
          "insights": {
            "const": 1
          },
          "audit": {
            "const": 1
          }
        },
        "additionalProperties": false
      },
      "review_policy_version": {
        "const": "human-reviewed-v1"
      },
      "derivation_versions": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "storage_policy": {
        "const": "local-no-backup-explicit-export"
      },
      "migration": {
        "type": "object",
        "required": [
          "from_version",
          "source_media_sha256",
          "method"
        ],
        "properties": {
          "from_version": {
            "const": 2
          },
          "source_media_sha256": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "const": "additive-v1"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "audit-v1.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "id",
      "sequence",
      "entity_id",
      "actor",
      "timestamp",
      "reason",
      "before",
      "after"
    ],
    "properties": {
      "entity_type": {
        "enum": [
          "event",
          "assignment",
          "participant",
          "rally"
        ]
      },
      "schema_version": {
        "const": 1
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "entity_id": {
        "type": "string",
        "minLength": 1
      },
      "actor": {
        "type": "string",
        "minLength": 1
      },
      "timestamp": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "before": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/entity"
          }
        ]
      },
      "after": {
        "$ref": "#/$defs/entity"
      }
    },
    "$defs": {
      "entity": {
        "oneOf": [
          {
            "$ref": "events-v2.schema.json#/$defs/event"
          },
          {
            "$ref": "events-v3.schema.json#/properties/assignments/items"
          },
          {
            "$ref": "events-v3.schema.json#/properties/participants/items"
          },
          {
            "$ref": "rallies-v1.schema.json#/properties/rallies/items"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "events-v2.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AnalysisPackage v2 events",
    "type": "object",
    "required": [
      "schema_version",
      "events"
    ],
    "properties": {
      "schema_version": {
        "const": 2
      },
      "events": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/event"
        }
      }
    },
    "$defs": {
      "event": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "start",
          "end",
          "scene",
          "player_id",
          "stroke",
          "position",
          "provenance",
          "reviewed",
          "confidence",
          "excluded",
          "favorite"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "hit",
              "bounce",
              "rally"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "scene": {
            "type": "integer",
            "minimum": 0
          },
          "player_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stroke": {
            "enum": [
              "serve",
              "forehand",
              "backhand",
              "volley",
              "overhead",
              "unknown"
            ]
          },
          "position": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "provenance": {
            "enum": [
              "automatic",
              "manual"
            ]
          },
          "reviewed": {
            "type": "boolean"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "excluded": {
            "type": "boolean"
          },
          "favorite": {
            "type": "boolean"
          }
        },
        "description": "Runtime additionally enforces end >= start, instantaneous hit/bounce times, unique IDs, and bounce-only positions."
      }
    }
  },
  "events-v3.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "events",
      "participants",
      "assignments",
      "links"
    ],
    "properties": {
      "schema_version": {
        "const": 3
      },
      "events": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "allOf": [
            {
              "$ref": "events-v2.schema.json#/$defs/event"
            },
            {
              "type": "object",
              "properties": {
                "participant_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "contact_interval": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "contact_point_image_px": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "hitter_position_court_m": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "field_confidence": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "position_source": {
                  "enum": [
                    "reviewed_bounce",
                    "legacy_v2",
                    null
                  ]
                }
              }
            }
          ]
        }
      },
      "participants": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "role"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "role": {
              "enum": [
                "self",
                "opponent",
                "partner",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "assignments": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "scene",
            "start",
            "end",
            "track_id",
            "side",
            "participant_id",
            "reviewed",
            "confidence"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scene": {
              "type": "integer",
              "minimum": 0
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "track_id": {
              "type": "integer"
            },
            "side": {
              "enum": [
                "near",
                "far"
              ]
            },
            "participant_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "reviewed": {
              "type": "boolean"
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "links": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "shot_id",
            "bounce_id",
            "reviewed",
            "confidence"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "shot_id": {
              "type": "string",
              "minLength": 1
            },
            "bounce_id": {
              "type": "string",
              "minLength": 1
            },
            "reviewed": {
              "type": "boolean"
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "insights-v1.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "insights"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "insights": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "observation",
            "interpretation",
            "action",
            "metric_ids",
            "event_ids",
            "confidence",
            "rule_version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "observation": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "metric_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "confidence": {
              "enum": [
                "limited",
                "moderate"
              ]
            },
            "rule_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "metrics-v1.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "metrics"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "metrics": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "definition",
            "version",
            "view",
            "value",
            "numerator",
            "denominator",
            "event_ids",
            "excluded_event_ids",
            "input_digest",
            "review_policy_version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "view": {
              "enum": [
                "human_verified",
                "assisted"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "numerator": {
              "type": "number",
              "minimum": 0
            },
            "denominator": {
              "type": "number",
              "minimum": 0
            },
            "event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "excluded_event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "input_digest": {
              "type": "string",
              "minLength": 1
            },
            "review_policy_version": {
              "const": "human-reviewed-v1"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "quality-v1.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Per-frame capture eligibility, not recognition accuracy",
    "type": "object",
    "required": [
      "schema_version",
      "eligible_for_positions",
      "court_visible",
      "camera_moving",
      "scene_cut",
      "calibration_id",
      "reasons"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "eligible_for_positions": {
        "type": "boolean"
      },
      "court_visible": {
        "type": "boolean"
      },
      "camera_moving": {
        "type": "boolean"
      },
      "scene_cut": {
        "type": "boolean"
      },
      "calibration_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "calibration_age_s": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "sharpness": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "reasons": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "missing_calibration",
            "invalid_calibration",
            "court_out_of_view",
            "camera_moving",
            "scene_cut",
            "stale_calibration",
            "low_sharpness"
          ]
        }
      }
    },
    "additionalProperties": false
  },
  "rallies-v1.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "rallies"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "rallies": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "start",
            "end",
            "shot_ids",
            "reviewed",
            "outcome"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "shot_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "reviewed": {
              "type": "boolean"
            },
            "outcome": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "self_won",
                "opponent_won",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "tracks-v1.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "schema_version",
      "timestamp",
      "scene",
      "track_id",
      "side",
      "position_court_m",
      "method",
      "reviewed",
      "calibration_id"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "timestamp": {
        "type": "number",
        "minimum": 0
      },
      "scene": {
        "type": "integer",
        "minimum": 0
      },
      "track_id": {
        "type": "integer"
      },
      "side": {
        "enum": [
          "near",
          "far",
          "unknown"
        ]
      },
      "position_court_m": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "method": {
        "enum": [
          "ankles_homography",
          "box_bottom_homography",
          null
        ]
      },
      "reviewed": {
        "type": "boolean"
      },
      "calibration_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "image_point_px": {
        "type": [
          "array",
          "null"
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      },
      "error_m": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "role_state": {
        "enum": [
          "candidate",
          "ambiguous",
          "unknown"
        ]
      }
    },
    "additionalProperties": false
  }
}
